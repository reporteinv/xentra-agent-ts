@echo off
chcp 65001 >nul
:: Auto-elevar permisos
fltMC >nul 2>&1
if %errorlevel% neq 0 (
    powershell -Command "Start-Process cmd -ArgumentList '/c cd /d ""%~dp0"" && ""%~f0""' -Verb RunAs -WorkingDirectory '%~dp0'"
    exit /b
)
set "SRCDIR=%~dp0"
cd /d "%SRCDIR%"

set "XENTRA_TOKEN_VALOR=__XENTRA_TOKEN__"
set "XENTRA_SERVER_VALOR=__XENTRA_SERVER__"

:menu
cls
echo.
echo  ========================================
echo          XENTRASOFT SETUP (unificado)
echo  ========================================
echo.
echo   1. Instalar
echo   2. Desinstalar
echo   3. Salir
echo.
echo  ========================================
echo.
set /p OPCION= Seleccione una opcion (1-3):
if "%OPCION%"=="1" goto instalar
if "%OPCION%"=="2" goto desinstalar
if "%OPCION%"=="3" goto salir
goto menu

:instalar
cls
echo.
echo  ========================================
echo          XENTRASOFT SETUP (unificado)
echo  ========================================
echo.
echo  [1/6] Limpiando instalacion previa...
schtasks /Delete /TN "XentraAgent"         /F >nul 2>&1
schtasks /Delete /TN "XentraAgentPoll"     /F >nul 2>&1
schtasks /Delete /TN "XentraAgentLogin"    /F >nul 2>&1
schtasks /Delete /TN "XentraAgentStartup"  /F >nul 2>&1
schtasks /Delete /TN "XentraAgentLimpieza" /F >nul 2>&1
schtasks /Delete /TN "XentraAgentUpdate"   /F >nul 2>&1
schtasks /Delete /TN "XentraAgentWatchdog" /F >nul 2>&1
attrib -h "C:\Xentra" >nul 2>&1
if exist "C:\Xentra" rmdir /S /Q "C:\Xentra" >nul 2>&1
echo  [1/6] OK
echo.
echo  [2/6] Configurando token y servidor del cliente...
setx XENTRA_TOKEN "%XENTRA_TOKEN_VALOR%" /M >nul
setx XENTRA_SERVER "%XENTRA_SERVER_VALOR%" /M >nul
set "XENTRA_TOKEN=%XENTRA_TOKEN_VALOR%"
set "XENTRA_SERVER=%XENTRA_SERVER_VALOR%"
echo  [2/6] OK - Servidor: %XENTRA_SERVER_VALOR%
echo.
echo  [3/6] Descargando agente...
mkdir "C:\Xentra" >nul 2>&1
powershell -Command "Add-MpPreference -ExclusionPath 'C:\Xentra'" >nul 2>&1
powershell -Command "Invoke-WebRequest -Uri '%XENTRA_SERVER_VALOR%/downloads/xentra-agent.exe' -OutFile 'C:\Xentra\xentra-agent.exe' -UseBasicParsing"
if not exist "C:\Xentra\xentra-agent.exe" (
    echo  ERROR: No se pudo descargar el agente.
    echo  Verifique la conexion a Internet.
    pause
    goto salir
)
attrib +h "C:\Xentra" >nul 2>&1
echo  [3/6] OK
echo.
echo  [4/6] Registrando tareas programadas...
"C:\Xentra\xentra-agent.exe" --instalar
echo  [4/6] OK
echo.
echo  [5/6] Ejecutando primer reporte...
start "" /B "C:\Xentra\xentra-agent.exe"
echo  [5/6] OK
echo.
echo  [6/6] Listo.
echo.
echo  ========================================
echo   === Instalacion EXITOSA ===
echo   Servidor:    %XENTRA_SERVER_VALOR%
echo   Auto-update: cada 6h
echo   Watchdog:    cada 15min
echo  ========================================
echo.
timeout /t 5 /nobreak >nul
goto salir

:desinstalar
cls
echo.
echo  Desinstalando...
echo.
for /f %%a in ('powershell -Command "(Get-CimInstance Win32_BIOS).SerialNumber.Trim()"') do set SERIAL=%%a
powershell -Command "try { $token = [System.Environment]::GetEnvironmentVariable('XENTRA_TOKEN', 'Machine'); $srv = [System.Environment]::GetEnvironmentVariable('XENTRA_SERVER', 'Machine'); if (-not $token) { $token = 'xnt_ungrd_2026' }; if (-not $srv) { $srv = 'https://ag2.xentrasoft.com' }; Invoke-RestMethod -Uri \"$srv/api/pc/pcs/%SERIAL%\" -Method Delete -Headers @{'X-Agent-Token'=$token} -TimeoutSec 10 } catch {}" >nul 2>&1
schtasks /Delete /TN "XentraAgent"         /F >nul 2>&1
schtasks /Delete /TN "XentraAgentPoll"     /F >nul 2>&1
schtasks /Delete /TN "XentraAgentLogin"    /F >nul 2>&1
schtasks /Delete /TN "XentraAgentStartup"  /F >nul 2>&1
schtasks /Delete /TN "XentraAgentLimpieza" /F >nul 2>&1
schtasks /Delete /TN "XentraAgentUpdate"   /F >nul 2>&1
schtasks /Delete /TN "XentraAgentWatchdog" /F >nul 2>&1
attrib -h "C:\Xentra" >nul 2>&1
rmdir /S /Q "C:\Xentra" >nul 2>&1
powershell -Command "Remove-MpPreference -ExclusionPath 'C:\Xentra'" >nul 2>&1
powershell -Command "[System.Environment]::SetEnvironmentVariable('XENTRA_TOKEN', $null, 'Machine'); [System.Environment]::SetEnvironmentVariable('XENTRA_SERVER', $null, 'Machine')" >nul 2>&1
cls
echo.
echo  === Desinstalacion EXITOSA ===
echo.
timeout /t 3 /nobreak >nul
goto salir

:salir
exit
